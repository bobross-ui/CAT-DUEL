{
  "expo": {
    "name": "CAT Duel",
    "slug": "cat-duel",
    "scheme": "catduel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2",
      "dark": {
        "image": "./assets/splash-icon-dark.png",
        "resizeMode": "contain",
        "backgroundColor": "#141312"
      }
    },
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:exam-duel.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDF3E0"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "exam-duel.com",
              "pathPrefix": "/profile"
            },
            {
              "scheme": "https",
              "host": "exam-duel.com",
              "pathPrefix": "/match"
            },
            {
              "scheme": "https",
              "host": "exam-duel.com",
              "pathPrefix": "/leaderboard"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
